// ADS — advertisers, campaigns, creatives, bookings, delivery stats
// (see Prd-v3/monitozastionforthelokul.md)
// ─────────────────────────────────────────────────────────────────────────────

enum AdvertiserStatus {
  pending
  approved
  suspended
}

enum AdPackageTier {
  micro_local
  growth
  brand
  national
}

enum AdPricingModel {
  cpm
  cpc
  fixed
}

enum AdCampaignStatus {
  draft
  pending_approval
  approved
  rejected
  scheduled
  live
  paused
  completed
  archived
}

enum AdPlacementType {
  feed_post
  search_slot
  story
  banner
}

enum AdCreativeStatus {
  pending_review
  approved
  rejected
  flagged
}

enum AdBookingStatus {
  requested
  approved
  rejected
  cancelled
}

model Advertiser {
  id           String           @id @default(cuid())
  name         String
  contactName  String
  contactEmail String
  contactPhone String?
  merchantId   String? // optional link to an on-platform Merchant
  status       AdvertiserStatus @default(pending)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  merchant  Merchant?    @relation(fields: [merchantId], references: [id])
  campaigns AdCampaign[]

  @@index([status])
  @@index([merchantId])
}

model AdCampaign {
  id            String           @id @default(cuid())
  advertiserId  String
  name          String
  objective     String?
  packageTier   AdPackageTier
  pricingModel  AdPricingModel
  budgetPaise   Int
  dailyCapPaise Int?
  spentPaise    Int              @default(0)
  startDate     DateTime
  endDate       DateTime
  // { pincodes: string[], categories: string[], timeOfDay?: "morning"|"evening" }
  targeting     Json?
  status        AdCampaignStatus @default(draft)
  reviewedById  String?
  reviewNote    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  advertiser Advertiser   @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  creatives  AdCreative[]
  bookings   AdBooking[]

  @@index([advertiserId])
  @@index([status])
  @@index([startDate, endDate])
}

model AdCreative {
  id              String           @id @default(cuid())
  campaignId      String
  placement       AdPlacementType
  headline        String
  body            String
  mediaKey        String? // R2 storage key
  ctaLabel        String           @default("Learn more")
  ctaUrl          String?
  status          AdCreativeStatus @default(pending_review)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  campaign   AdCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  dailyStats AdEventDaily[]

  @@index([campaignId])
  @@index([status])
}

// Inventory reservation: placement × pincode × date range.
model AdBooking {
  id           String          @id @default(cuid())
  campaignId   String
  placement    AdPlacementType
  pinCode      String
  startDate    DateTime
  endDate      DateTime
  quotePaise   Int
  status       AdBookingStatus @default(requested)
  decisionNote String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime        @default(now())

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status])
  @@index([placement, pinCode, startDate, endDate])
}

// Aggregated delivery stats — one row per creative per day (no per-user rows).
model AdEventDaily {
  id          String   @id @default(cuid())
  creativeId  String
  date        DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  hides       Int      @default(0)
  spendPaise  Int      @default(0)

  creative AdCreative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@unique([creativeId, date])
  @@index([date])
}

