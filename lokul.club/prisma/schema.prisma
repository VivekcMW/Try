  storeName       String
  items           String
  totalPaise      Int
  status          DeliveryOrderStatus @default(preparing)
  estimatedTime   String?
  deliveryPartner String?
  pinCode         String
  createdAt       DateTime            @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([pinCode])
}

// Amenity booking

enum AmenityBookingStatus {
  upcoming
  completed
  cancelled
}

model AmenityBooking {
  id              String               @id @default(cuid())
  ownerId         String
  amenityId       String
  amenityName     String
  amenityIcon     String
  dateLabel       String
  dateISO         DateTime
  timeSlot        String
  status          AmenityBookingStatus @default(upcoming)
  bookingRef      String
  totalPricePaise Int
  pinCode         String
  createdAt       DateTime             @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([pinCode])
}
